# Karofi standalone — Supabase Singapore (NOT shared DQA-home demo).
# Project ref: create at https://supabase.com/dashboard → New project → Singapore
#
# Quick setup — điền KAROFI_SG_* trong .env (xem .env.karofi.sg.credentials.example):
#   pnpm webapp:setup:karofi:sg
#
# Seoul source (migration only): .env.seoul — copy from .env.seoul.example

PROJECT_REF="frgqshzrhpatolttqqdx"

DATABASE_URL="postgres://postgres.${PROJECT_REF}:${SUPABASE_DB_PASSWORD}@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.${PROJECT_REF}:${SUPABASE_DB_PASSWORD}@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

SESSION_SECRET="generate-with-openssl-rand-hex-32"
SUPABASE_ANON_PUBLIC="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZyZ3FzaHpyaHBhdG9sdHRxcWR4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMzNDI5OTgsImV4cCI6MjA5ODkxODk5OH0.pExIzcvBBESoDemeVTgljMu66MyC6afAKF1Dj37U5Ak"
SUPABASE_SERVICE_ROLE="${SUPABASE_SERVICE_ROLE}"
SUPABASE_URL="https://${PROJECT_REF}.supabase.co"
SERVER_URL="http://localhost:3000"

DATABASE_PROVIDER="postgresql"
PLATFORM_PROFILE="karofi"
AUTH_DRIVER="supabase"
STORAGE_DRIVER="supabase"
JOB_QUEUE_DRIVER="pgboss"

APP_NAME="Karofi"
DEFAULT_LOCALE="vi"
DEMO_VI="true"
COOKIE_DOMAIN=""

ENABLE_PREMIUM_FEATURES="false"
DISABLE_SIGNUP="true"
DISABLE_SSO="true"
SEND_ONBOARDING_EMAIL="false"
DISABLE_HTTPS="true"

FINGERPRINT="generate-with-openssl-rand-hex-32"
INVITE_TOKEN_SECRET="generate-with-openssl-rand-hex-32"

STRIPE_SECRET_KEY="stripe-secret-key"
STRIPE_PUBLIC_KEY="stripe-public-key"
STRIPE_WEBHOOK_ENDPOINT_SECRET="stripe-endpoint-secret"
FREE_TRIAL_DAYS="14"

SMTP_PWD="super-safe-passw0rd"
SMTP_HOST="mail.example.com"
SMTP_PORT=465
SMTP_USER="some-email@example.com"
SMTP_FROM="Karofi <noreply@example.com>"

MAPTILER_TOKEN="maptiler-token"
GEOCODING_USER_AGENT="Karofi Asset Management"
SENTRY_DSN=""

ADMIN_EMAIL="admin@dqa-karofi.io.vn"
DEMO_ADMIN_EMAIL="admin@dqa-karofi.io.vn"
DEMO_ADMIN_PASSWORD="KarofiAdmin123!"
SUPPORT_EMAIL="support@karofi.local"
FULL_CALENDAR_LICENSE_KEY="full-calendar-license-key"

# NocoDB — optional; leave empty to decouple from DQA-home Deplou instance
# NOCODB_URL=
# NOCODB_API_TOKEN=
# NOCODB_BASE_ID=
